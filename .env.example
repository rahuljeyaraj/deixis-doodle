# Copy to .env and fill in. Never commit .env.
# Git worktrees don't get this file automatically: copy .env into a worktree if it needs keys.

# Nebius Token Factory (Nemotron)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Empty uses the code default, nvidia/Nemotron-3_5-Lightning (R3, session AGENT).
NEMOTRON_MODEL=

# Nebius Serverless Endpoint for Cosmos (vLLM, OpenAI-compatible)
# COSMOS_BASE_URL comes from `bash scripts/nebius/cosmos_endpoint.sh url` (run in WSL).
COSMOS_BASE_URL=
# COSMOS_ENDPOINT_TOKEN is also accepted as the name of this key.
COSMOS_API_KEY=
COSMOS_MODEL=nvidia/Cosmos3-Nano
# Optional: only for gated Hugging Face models (e.g. the reason2 profile).
HF_TOKEN=
# Optional: a Nebius project in another region (e.g. eu-north1 for L40S).
NEBIUS_PARENT_ID=

# Optional remote speech endpoint (Nemotron ASR / Magpie TTS)
SPEECH_BASE_URL=

# Local speech recognition (R2, session SPEECH): parakeet_v2, nemotron35 or nemotron_en
ASR_MODEL=parakeet_v2

# Hardware
SERIAL_PORT=
CAMERA_INDEX=0
# Empty uses the default input device (capture prefers its WASAPI twin).
AUDIO_DEVICE=
